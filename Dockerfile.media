FROM --platform=linux/amd64 node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip ca-certificates \
  && python3 -m pip install --break-system-packages --no-cache-dir 'yt-dlp[default]' \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY youtube-url.mjs youtube-audio.mjs media-server.mjs ./
EXPOSE 8080
CMD ["node", "media-server.mjs"]
